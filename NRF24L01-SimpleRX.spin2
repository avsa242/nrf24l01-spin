#include "core.con.click.spin2"

CON

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000

' -- User-modifiable constants
    CLICK_BASE  = 0                             ' 0, 16, 32, 48
    PAYLD_LEN   = 8
' --


OBJ

    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000

    { use with MikroE Click boards - define the CLICK_BASE I/O pin above and leave these as-is }
    radio:  "wireless.transceiver.nrf24l01" | CE=RES_PIN, CS=CS_PIN, SCK=SCK_PIN, MOSI=MOSI_PIN, MISO=MISO_PIN, SPI_FREQ=10_000_000

    { use custom I/O pins; comment out the line above and uncomment this one }
'    radio:  "wireless.transceiver.nrf24l01" | CE=0, CS=1, SCK=2, MOSI=3, MISO=4, SPI_FREQ=10_000_000


VAR

    byte _payload[PAYLD_LEN]


PUB main()

    ser.start()

    ifnot ( radio.start() )
        ser.strln(@"NRF24L01 driver failed to start")
        { double-check I/O pins if the driver doesn't start }
        repeat

    radio.preset_rx2m()                         ' set up for defaults, 2Mbps speed
    radio.payld_len(PAYLD_LEN)                  ' expect to receive PAYLD_LEN number of bytes

    ser.clear()

    repeat
        repeat until radio.payld_rdy()
        radio.rx_payld(PAYLD_LEN, @_payload)
        ser.printf(@"Received: %s\n\r", @_payload)

        { clear interrupt so RX can continue }
        radio.int_clear(radio.INT_PAYLD_RDY)


DAT
