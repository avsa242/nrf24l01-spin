{
----------------------------------------------------------------------------------------------------
    Filename:       NRF24L01-PacketLoss-TX.spin2
    Description:    nRF24L01+ Transmit demo
        * Packet loss measurement
        Run this transmitter on one node, and monitor the receiving node
        for packet loss with NRF24L01-PacketLoss-RX.spin.
    Author:         Jesse Burt
    Started:        Jan 5, 2023
    Updated:        Aug 26, 2024
    Copyright (c) 2024 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}
#include "core.con.click.spin2"

CON

    _clkfreq    = 180_000_000
    _xtlfreq    = 20_000_000

' -- User-modifiable constants
    CLICK_BASE  = 16                            ' 0, 16, 32, 48
' --

    PAYLD_LEN   = 2


OBJ

    str:    "string"
    ser:    "com.serial.terminal.ansi" | SER_BAUD=2_000_000

    { use with MikroE Click boards - define the CLICK_BASE I/O pin above and leave these as-is }
    radio:  "wireless.transceiver.nrf24l01" | CE=RES_PIN, CS=CS_PIN, SCK=SCK_PIN, MOSI=MOSI_PIN, MISO=MISO_PIN, SPI_FREQ=10_000_000

    { use custom I/O pins; comment out the line above and uncomment this one }
'    radio:  "wireless.transceiver.nrf24l01" | CE=0, CS=1, SCK=2, MOSI=3, MISO=4, SPI_FREQ=10_000_000


PUB main() | payld_cnt

    ser.start()

    ifnot ( radio.start() )
        ser.strln(@"NRF24L01 driver failed to start")
        repeat

    radio.preset_tx2m()                         ' set up for defaults, 2Mbps speed
    radio.payld_len(PAYLD_LEN)                  ' send PAYLD_LEN number of bytes
    ser.clear()

    payld_cnt := 0
    repeat
        ser.pos_xy(0, 0)
        ser.printf(@"Packets transmitted: %5.5d", payld_cnt)

        { payload to transmit }
        radio.tx_payld(PAYLD_LEN, @payld_cnt)
        payld_cnt++

        { clear interrupt so TX can continue }
        radio.int_clear(radio.INT_MAX_RETRANS)
        waitms(100)


DAT
